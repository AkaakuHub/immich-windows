From: immich-windows <local@immich-windows.invalid>
Subject: [PATCH] server: propagate job errors to BullMQ

Retain failed OCR and other jobs in the failed queue when their processor
throws, while preserving lifecycle events and successful follow-up work.

diff --git a/server/src/services/job.service.ts b/server/src/services/job.service.ts
--- a/server/src/services/job.service.ts
+++ b/server/src/services/job.service.ts
@@ -91,8 +91,9 @@
       if (response && typeof response === 'string' && [JobStatus.Success, JobStatus.Skipped].includes(response)) {
         await this.onDone(job);
       }
-    } catch (error: Error | any) {
+    } catch (error) {
       await this.eventRepository.emit('JobError', { job, error });
+      throw error;
     } finally {
       await this.eventRepository.emit('JobComplete', queueName, job);
     }
