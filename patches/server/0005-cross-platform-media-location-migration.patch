From: immich-windows <local@immich-windows.invalid>
Subject: [PATCH] server: canonicalize Windows media paths and repair integrity reports

Normalize migrated paths and existing Windows database paths to native separators.
Remove only reports for referenced files and merge duplicate reports without
deleting media files.

diff --git a/server/src/repositories/database.repository.ts b/server/src/repositories/database.repository.ts
--- a/server/src/repositories/database.repository.ts
+++ b/server/src/repositories/database.repository.ts
@@ -411,41 +411,42 @@
   }

   async migrateFilePaths(sourceFolder: string, targetFolder: string): Promise<void> {
-    // remove trailing slashes
-    if (sourceFolder.endsWith('/')) {
+    if (sourceFolder.endsWith('/') || sourceFolder.endsWith('\\')) {
       sourceFolder = sourceFolder.slice(0, -1);
     }

-    if (targetFolder.endsWith('/')) {
+    if (targetFolder.endsWith('/') || targetFolder.endsWith('\\')) {
       targetFolder = targetFolder.slice(0, -1);
     }

     // escaping regex special characters with a backslash
     const sourceRegex = '^' + sourceFolder.replaceAll(/[-[\]{}()*+?.,\\^$|#\s]/g, String.raw`\$&`);
-    const source = sql.raw(`'${sourceRegex}'`);
-    const target = sql.lit(targetFolder);
+    const source = sql.lit(sourceRegex);
+    const target = sql.lit(targetFolder.replaceAll('\\', String.raw`\\`));
+    const migratedPath = (column: string) => {
+      const expression = sql<string>`regexp_replace(${sql.ref(column)}, ${source}, ${target})`;
+      return process.platform === 'win32' ? sql<string>`replace(${expression}, '/', ${'\\'})` : expression;
+    };

     await this.db.transaction().execute(async (tx) => {
       await tx
         .updateTable('asset')
-        .set((eb) => ({
-          originalPath: eb.fn('REGEXP_REPLACE', ['originalPath', source, target]),
-        }))
+        .set({ originalPath: migratedPath('originalPath') })
         .execute();

       await tx
         .updateTable('asset_file')
-        .set((eb) => ({ path: eb.fn('REGEXP_REPLACE', ['path', source, target]) }))
+        .set({ path: migratedPath('path') })
         .execute();

       await tx
         .updateTable('person')
-        .set((eb) => ({ thumbnailPath: eb.fn('REGEXP_REPLACE', ['thumbnailPath', source, target]) }))
+        .set({ thumbnailPath: migratedPath('thumbnailPath') })
         .execute();

       await tx
         .updateTable('user')
-        .set((eb) => ({ profileImagePath: eb.fn('REGEXP_REPLACE', ['profileImagePath', source, target]) }))
+        .set({ profileImagePath: migratedPath('profileImagePath') })
         .execute();
     });
   }
