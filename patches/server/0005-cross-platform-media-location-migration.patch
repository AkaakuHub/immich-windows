new file mode 100644
--- /dev/null
+++ b/server/src/schema/migrations/1787148183731-NormalizeWindowsMediaPaths.ts
@@ -0,0 +1,37 @@
+import { Kysely, sql } from 'kysely';
+import { DB } from 'src/schema';
+
+export async function up(db: Kysely<DB>): Promise<void> {
+  if (process.platform !== 'win32') {
+    return;
+  }
+
+  await sql`UPDATE asset SET "originalPath" = replace("originalPath", '/', chr(92))
+    WHERE strpos("originalPath", '/') > 0`.execute(db);
+  await sql`UPDATE asset_file SET path = replace(path, '/', chr(92))
+    WHERE strpos(path, '/') > 0`.execute(db);
+  await sql`UPDATE person SET "thumbnailPath" = replace("thumbnailPath", '/', chr(92))
+    WHERE strpos("thumbnailPath", '/') > 0`.execute(db);
+  await sql`UPDATE "user" SET "profileImagePath" = replace("profileImagePath", '/', chr(92))
+    WHERE strpos("profileImagePath", '/') > 0`.execute(db);
+
+  await sql`DELETE FROM integrity_report AS report
+    WHERE report.type = 'untracked_file' AND replace(report.path, '/', chr(92)) IN (
+      SELECT "originalPath" FROM asset
+      UNION SELECT path FROM asset_file
+      UNION SELECT "thumbnailPath" FROM person
+    )`.execute(db);
+
+  await sql`DELETE FROM integrity_report WHERE id IN (
+    SELECT id FROM (
+      SELECT id, row_number() OVER (
+        PARTITION BY type, replace(path, '/', chr(92))
+        ORDER BY ("assetId" IS NOT NULL OR "fileAssetId" IS NOT NULL) DESC, "createdAt" DESC, id
+      ) AS position FROM integrity_report
+    ) AS duplicates WHERE position > 1
+  )`.execute(db);
+  await sql`UPDATE integrity_report SET path = replace(path, '/', chr(92))
+    WHERE strpos(path, '/') > 0`.execute(db);
+}
+
+export async function down(): Promise<void> {}
