From: immich-windows <local@immich-windows.invalid>
Subject: [PATCH] machine-learning: require fail-closed Windows DirectML execution

diff --git a/machine-learning/immich_ml/config.py b/machine-learning/immich_ml/config.py
index d1e44fd..96d3255 100644
--- a/machine-learning/immich_ml/config.py
+++ b/machine-learning/immich_ml/config.py
@@ -77,6 +77,14 @@ class Settings(BaseSettings):
     openvino_precision: ModelPrecision = ModelPrecision.FP32
     rocm_precision: ModelPrecision = ModelPrecision.FP32
 
+    @property
+    def accelerator(self) -> str:
+        accelerator = os.environ.get("MACHINE_LEARNING_ACCELERATOR", "cpu").lower()
+        allowed = {"cpu", "directml"}
+        if accelerator not in allowed:
+            raise ValueError(f"Unknown machine learning accelerator '{accelerator}'. Expected one of {sorted(allowed)}")
+        return accelerator
+
     @property
     def device_id(self) -> str:
         return os.environ.get("MACHINE_LEARNING_DEVICE_ID", "0")
diff --git a/machine-learning/immich_ml/models/facial_recognition/recognition.py b/machine-learning/immich_ml/models/facial_recognition/recognition.py
index 2b0575e..d32975b 100644
--- a/machine-learning/immich_ml/models/facial_recognition/recognition.py
+++ b/machine-learning/immich_ml/models/facial_recognition/recognition.py
@@ -83,8 +83,12 @@ class FaceRecognizer(InferenceModel):
     @property
     def _batch_size_default(self) -> int | None:
         providers = ort.get_available_providers()
+        directml_active = (
+            settings.accelerator == "directml" and "DmlExecutionProvider" in providers
+        )
         if (
             self.model_format == ModelFormat.ONNX
+            and not directml_active
             and "MIGraphXExecutionProvider" not in providers
             and "OpenVINOExecutionProvider" not in providers
         ):
diff --git a/machine-learning/immich_ml/sessions/ort.py b/machine-learning/immich_ml/sessions/ort.py
index 95a4078..7e94a5e 100644
--- a/machine-learning/immich_ml/sessions/ort.py
+++ b/machine-learning/immich_ml/sessions/ort.py
@@ -9,7 +9,6 @@ import numpy as np
 import onnxruntime as ort
 from numpy.typing import NDArray
 
-from immich_ml.models.constants import SUPPORTED_PROVIDERS
 from immich_ml.schemas import ModelPrecision, SessionNode
 
 from ..config import log, settings
@@ -56,14 +55,31 @@ class OrtSession:
     ):
         self.model_path = Path(model_path)
         self.providers = providers if providers is not None else self._providers_default
+        if settings.accelerator == "directml" and self.providers != ["DmlExecutionProvider"]:
+            raise ValueError("DirectML requires DmlExecutionProvider only; CPU fallback is disabled")
+        directml = "DmlExecutionProvider" in self.providers
+        if directml and self.providers != ["DmlExecutionProvider"]:
+            raise ValueError("DirectML cannot be combined with another execution provider")
+        self._run_lock = Lock() if directml else None
         self.provider_options = provider_options if provider_options is not None else self._provider_options_default
         self.sess_options = sess_options if sess_options is not None else self._sess_options_default
+        if directml:
+            # Apply constraints even when the caller supplies its own SessionOptions.
+            self.sess_options.enable_mem_pattern = False
+            self.sess_options.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
+            self.sess_options.add_session_config_entry("session.disable_cpu_ep_fallback", "1")
         self.session = ort.InferenceSession(
             self.model_path.as_posix(),
             providers=self.providers,
             provider_options=self.provider_options,
             sess_options=self.sess_options,
+            enable_fallback=False,
         )
+        if "DmlExecutionProvider" in self.providers:
+            active_providers = self.session.get_providers()
+            if active_providers != ["DmlExecutionProvider"]:
+                raise RuntimeError(f"DirectML session initialization failed; active providers: {active_providers}")
+
 
     def get_inputs(self) -> Sequence[SessionNode]:
         inputs: Sequence[SessionNode] = self.session.get_inputs()
@@ -83,6 +99,10 @@ class OrtSession:
         input_feed: dict[str, NDArray[np.float32]] | dict[str, NDArray[np.int32]] | dict[str, NDArray[np.uint8]],
         run_options: Any = None,
     ) -> list[NDArray[np.float32]]:
+        if self._run_lock is not None:
+            with self._run_lock:
+                return self.session.run(output_names, input_feed, run_options)
+
         if "MIGraphXExecutionProvider" in self.providers:
             model_key = self.model_path.resolve().as_posix()
             input_key = (model_key, _migraphx_input_signature(input_feed))
@@ -113,7 +133,13 @@ class OrtSession:
     def _providers_default(self) -> list[str]:
         available_providers = set(ort.get_available_providers())
         log.debug(f"Available ORT providers: {available_providers}")
-        return [provider for provider in SUPPORTED_PROVIDERS if provider in available_providers]
+        if settings.accelerator == "cpu":
+            return ["CPUExecutionProvider"]
+        if "DmlExecutionProvider" not in available_providers:
+            raise RuntimeError(
+                "DirectML was requested but DmlExecutionProvider is not available in this ONNX Runtime build."
+            )
+        return ["DmlExecutionProvider"]
 
     @property
     def provider_options(self) -> list[dict[str, Any]]:
@@ -131,6 +157,8 @@ class OrtSession:
             match provider:
                 case "CPUExecutionProvider":
                     options = {"arena_extend_strategy": "kSameAsRequested"}
+                case "DmlExecutionProvider":
+                    options = {"device_id": settings.device_id}
                 case "CUDAExecutionProvider":
                     options = {"arena_extend_strategy": "kSameAsRequested", "device_id": settings.device_id}
                 case "MIGraphXExecutionProvider":
