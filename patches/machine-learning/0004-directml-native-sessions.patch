diff --git a/machine-learning/immich_ml/sessions/directml_api.py b/machine-learning/immich_ml/sessions/directml_api.py
new file mode 100644
--- /dev/null
+++ b/machine-learning/immich_ml/sessions/directml_api.py
@@ -0,0 +1,78 @@
+import ctypes as C
+from threading import Lock
+from pathlib import Path
+
+import onnxruntime as ort
+
+P = C.c_void_p
+PP = C.POINTER(P)
+S = C.c_size_t
+I = C.c_int
+CP = C.c_char_p
+CPP = C.POINTER(CP)
+I64P = C.POINTER(C.c_int64)
+
+
+class DirectMLApi:
+    def __init__(self):
+        dll = Path(ort.__file__).parent / 'capi' / 'onnxruntime.dll'
+        self.dll = C.WinDLL(str(dll))
+        self.dll.OrtGetApiBase.restype = C.POINTER(P)
+        base = self.dll.OrtGetApiBase()
+        get_api = C.WINFUNCTYPE(C.POINTER(P), C.c_uint32)(base[0])
+        self.table = get_api(24)
+        if not self.table:
+            raise RuntimeError('ONNX Runtime API 24 is unavailable')
+        self.error_message = self.bind(2, CP, P)
+        self.release_status = self.bind(93, None, P)
+        self.create_env = self.bind(3, P, I, CP, PP)
+        self.create_session = self.bind(7, P, P, C.c_wchar_p, P, PP)
+        self.run = self.bind(9, P, P, P, CPP, PP, S, CPP, S, PP)
+        self.options = self.bind(10, P, PP)
+        self.mode = self.bind(13, P, P, I)
+        self.disable_pattern = self.bind(17, P, P)
+        self.disable_arena = self.bind(19, P, P)
+        self.optimization = self.bind(23, P, P, I)
+        self.intra = self.bind(24, P, P, I)
+        self.inter = self.bind(25, P, P, I)
+        self.tensor = self.bind(49, P, P, P, S, I64P, S, I, PP)
+        self.tensor_data = self.bind(51, P, P, PP)
+        self.element_type = self.bind(60, P, P, C.POINTER(I))
+        self.dimensions_count = self.bind(61, P, P, C.POINTER(S))
+        self.dimensions = self.bind(62, P, P, I64P, S)
+        self.shape = self.bind(65, P, P, PP)
+        self.memory = self.bind(69, P, I, I, PP)
+        self.release_session = self.bind(95, None, P)
+        self.release_value = self.bind(96, None, P)
+        self.release_shape = self.bind(99, None, P)
+        self.release_options = self.bind(100, None, P)
+        self.config = self.bind(130, P, P, CP, CP)
+        self.provider = self.bind(216, P, P, CP, CPP, CPP, S)
+        self.env = P()
+        self.cpu_memory = P()
+        self.check(self.create_env(3, b'immich-directml', C.byref(self.env)))
+        self.check(self.memory(0, 0, C.byref(self.cpu_memory)))
+
+    def bind(self, index, result, *args):
+        return C.WINFUNCTYPE(result, *args)(self.table[index])
+
+    def check(self, status):
+        if status:
+            try:
+                message = self.error_message(status).decode('utf-8', errors='replace')
+            finally:
+                self.release_status(status)
+            raise RuntimeError(message)
+
+
+
+_api = None
+_api_lock = Lock()
+
+
+def get_api():
+    global _api
+    with _api_lock:
+        if _api is None:
+            _api = DirectMLApi()
+        return _api
diff --git a/machine-learning/immich_ml/sessions/directml_native.py b/machine-learning/immich_ml/sessions/directml_native.py
new file mode 100644
--- /dev/null
+++ b/machine-learning/immich_ml/sessions/directml_native.py
@@ -0,0 +1,109 @@
+import ctypes as C
+from pathlib import Path
+from types import SimpleNamespace
+from weakref import finalize
+
+import numpy as np
+
+from .directml_api import CP, I, P, PP, S, get_api
+from .directml_dynamic import _nodes
+from .onnx_external import read_external_model
+
+ELEMENT_TYPES = {1: np.dtype('float32'), 2: np.dtype('uint8'), 3: np.dtype('int8'),
+                 4: np.dtype('uint16'), 5: np.dtype('int16'), 6: np.dtype('int32'),
+                 7: np.dtype('int64'), 9: np.dtype('bool'), 10: np.dtype('float16'),
+                 11: np.dtype('float64'), 12: np.dtype('uint32'), 13: np.dtype('uint64')}
+DTYPE_TYPES = {dtype: element for element, dtype in ELEMENT_TYPES.items()}
+
+
+class DirectMLNativeSession:
+    def __init__(self, model_path, providers, provider_options, sess_options, **kwargs):
+        if providers != ['DmlExecutionProvider']:
+            raise ValueError('Native DirectML session requires DirectML only')
+        self.api = get_api()
+        self.handle = P()
+        model = read_external_model(Path(model_path))
+        self.inputs = _nodes(model.graph.input)
+        self.outputs = _nodes(model.graph.output)
+        self.metadata = {entry.key: entry.value for entry in model.metadata_props}
+        options = P()
+        self.api.check(self.api.options(C.byref(options)))
+        try:
+            self.api.check(self.api.mode(options, 0))
+            self.api.check(self.api.disable_pattern(options))
+            if not sess_options.enable_cpu_mem_arena:
+                self.api.check(self.api.disable_arena(options))
+            self.api.check(self.api.optimization(options, int(sess_options.graph_optimization_level)))
+            self.api.check(self.api.intra(options, sess_options.intra_op_num_threads))
+            self.api.check(self.api.inter(options, sess_options.inter_op_num_threads))
+            for name, value in [('session.disable_cpu_ep_fallback', '1'), ('ep.dml.disable_graph_fusion', '1')]:
+                self.api.check(self.api.config(options, name.encode(), value.encode()))
+            settings = provider_options[0]
+            keys = (CP * len(settings))(*(name.encode() for name in settings))
+            values = (CP * len(settings))(*(str(value).encode() for value in settings.values()))
+            self.api.check(self.api.provider(options, b'DML', keys, values, len(settings)))
+            self.api.check(self.api.create_session(self.api.env, str(Path(model_path).resolve()), options, C.byref(self.handle)))
+        finally:
+            self.api.release_options(options)
+        self._release_session = finalize(self, self.api.release_session, self.handle.value)
+
+    def get_inputs(self):
+        return self.inputs
+
+    def get_outputs(self):
+        return self.outputs
+
+    def get_modelmeta(self):
+        return SimpleNamespace(custom_metadata_map=self.metadata)
+
+    def get_providers(self):
+        return ['DmlExecutionProvider', 'CPUExecutionProvider']
+
+    def run(self, output_names, input_feed, run_options=None):
+        if run_options is not None:
+            raise ValueError('RunOptions are unsupported by this diagnostic prototype')
+        names = list(input_feed)
+        arrays = [np.ascontiguousarray(input_feed[name]) for name in names]
+        inputs = (P * len(names))()
+        outputs_names = output_names if output_names is not None else [node.name for node in self.outputs]
+        outputs = (P * len(outputs_names))()
+        try:
+            for index, array in enumerate(arrays):
+                shape = (C.c_int64 * array.ndim)(*array.shape)
+                self.api.check(self.api.tensor(self.api.cpu_memory, array.ctypes.data, array.nbytes, shape,
+                                     array.ndim, DTYPE_TYPES[array.dtype], C.cast(C.byref(inputs, index * C.sizeof(P)), PP)))
+            native_names = (CP * len(names))(*(name.encode() for name in names))
+            native_outputs = (CP * len(outputs_names))(*(name.encode() for name in outputs_names))
+            self.api.check(self.api.run(self.handle, None, native_names, inputs, len(names), native_outputs, len(outputs_names), outputs))
+            result = []
+            for handle in outputs:
+                info = P()
+                self.api.check(self.api.shape(handle, C.byref(info)))
+                try:
+                    count = S()
+                    element = I()
+                    self.api.check(self.api.dimensions_count(info, C.byref(count)))
+                    dimensions = (C.c_int64 * count.value)()
+                    self.api.check(self.api.dimensions(info, dimensions, count.value))
+                    self.api.check(self.api.element_type(info, C.byref(element)))
+                    dtype = ELEMENT_TYPES[element.value]
+                    shape = tuple(dimensions)
+                    size = int(np.prod(shape, dtype=np.int64))
+                    if size == 0:
+                        result.append(np.empty(shape, dtype=dtype))
+                    else:
+                        data = P()
+                        self.api.check(self.api.tensor_data(handle, C.byref(data)))
+                        raw = (C.c_ubyte * (size * dtype.itemsize)).from_address(data.value)
+                        result.append(np.ctypeslib.as_array(raw).view(dtype).reshape(shape).copy())
+                finally:
+                    self.api.release_shape(info)
+            return result
+        finally:
+            for handle in inputs:
+                if handle:
+                    self.api.release_value(handle)
+            for handle in outputs:
+                if handle:
+                    self.api.release_value(handle)
+
