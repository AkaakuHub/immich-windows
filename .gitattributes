# Patch files must retain LF endings so git apply sees byte-stable context on Windows.
*.patch text eol=lf
patches/series text eol=lf

# Repository metadata is kept deterministic across build hosts.
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf

# Byte-exact published legacy requirements fixture.
tests/fixtures/ml-requirements-v3.2.2.txt text eol=lf
