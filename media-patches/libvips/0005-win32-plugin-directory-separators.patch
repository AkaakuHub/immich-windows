diff --git a/libvips/iofuncs/init.c b/libvips/iofuncs/init.c
--- a/libvips/iofuncs/init.c
+++ b/libvips/iofuncs/init.c
@@ -286,4 +286,11 @@ vips_load_plugins(const char *fmt, ...)
 	(void) g_vsnprintf(dir_name, VIPS_PATH_MAX, fmt, ap);
 	va_end(ap);
 
+#ifdef G_OS_WIN32
+	/* Extended Windows paths require backslashes for GLib directory scans. */
+	for (char *p = dir_name; *p; p++)
+		if (*p == '/')
+			*p = '\\';
+#endif
+
 	g_info("searching \"%s\"", dir_name);
